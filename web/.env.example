# Dev: leave empty — Vite proxies /api and /health to test-backend :3001
VITE_ADMIN_API_URL=http://localhost:3001
VITE_TESTER_API_URL=http://localhost:3001

# Docker compose: leave VITE_* unset or empty at build — browser uses same origin; nginx proxies /api + /health
# VITE_ADMIN_API_URL=
# VITE_TESTER_API_URL=
# Standalone portal host (optional): VITE_ADMIN_API_URL=https://portal.yourdomain.com

# Portal password is set on test-backend only (PORTAL_PASSWORD) — never in VITE_* vars
